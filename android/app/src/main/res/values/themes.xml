<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DevxyzFiles" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/devxyz_bg</item>
        <item name="android:navigationBarColor">@color/devxyz_bg</item>
    </style>

    <style name="Theme.DevxyzFiles.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/devxyz_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/devxyz_bg</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.DevxyzFiles</item>
    </style>
</resources>
